{
  "name": "@svalchev/crankwave",
  "version": "0.1.0",
  "description": "Crankwave vehicle-engine authoring, live audition, baking, and runtime integration for SPARQ",
  "type": "module",
  "sparq": {
    "role": "client"
  },
  "engines": {
    "sparq": ">=0.1.0 <0.2.0"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/model.ts",
    "./authoring-contract": "./src/authoring-contract.ts",
    "./authoring-semantics": "./src/authoring-semantics.ts",
    "./resources": "./src/resources.ts",
    "./runtime": "./src/runtime.ts",
    "./audio-worker": "./src/audio-worker.ts",
    "./presets": "./src/presets.ts",
    "./document-service": "./src/document-service.ts",
    "./document-view": "./src/VehicleEngineLabDocument.tsx",
    "./editor": "./src/editor.ts"
  },
  "files": [
    "src/",
    "generated/",
    "vendor/",
    "docs/assets/sparq-logo.png",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "author": "Svetlozar Valchev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SvetlozarValchev/sparq-crankwave.git"
  },
  "homepage": "https://playsparq.com",
  "keywords": [
    "vehicle-engine",
    "engine-sim",
    "crankwave",
    "vehicle-audio"
  ],
  "dependencies": {
    "@sparq/editor-context": "workspace:^",
    "@sparq/editor-documents": "workspace:^",
    "@sparq/shared": "workspace:^",
    "@sparq/ui-kit": "workspace:^",
    "@sparq/workbench": "workspace:^"
  },
  "peerDependencies": {
    "@sparq/react": "workspace:^",
    "@sparq/workbench-host": "workspace:^"
  }
}
